RRB_INITIAL_ADMIN_PASSWORD=CHANGE_ME_WITH_AT_LEAST_20_RANDOM_CHARACTERS
RRB_HTTP_PORT=8080
RRB_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Optional: comma-separated exact host names, IPs, or CIDRs for REST/S3/SFTP.
# Empty keeps the backwards-compatible unrestricted behavior.
RRB_ALLOWED_REMOTE_TARGETS=
RRB_LOGIN_RETENTION_DAYS=30
RRB_JOB_RETENTION_DAYS=30
RRB_AUDIT_RETENTION_DAYS=90

# Nur für direkten HTTPS-Betrieb mit compose.https.yaml:
# RRB_TLS_CERT_HOST_PATH=/etc/letsencrypt/live/backup.example/fullchain.pem
# RRB_TLS_KEY_HOST_PATH=/etc/letsencrypt/live/backup.example/privkey.pem

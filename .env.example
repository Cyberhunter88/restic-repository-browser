RRB_INITIAL_ADMIN_PASSWORD=CHANGE_ME_WITH_AT_LEAST_20_RANDOM_CHARACTERS
RRB_HTTP_PORT=8080
RRB_TRUSTED_PROXY_IPS=127.0.0.1,::1

